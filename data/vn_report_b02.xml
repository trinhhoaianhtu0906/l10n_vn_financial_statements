<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_b02" model="vn.report">
        <field name="name">B02-DN Income Statement</field>
        <field name="code">B02-DN</field>
        <field name="sequence">20</field>
        <field name="kind">period</field>
        <field name="form_code">Form B 02 - DN</field>
        <field name="form_note">(Issued with Circular No. 99/2025/TT-BTC of 27 October 2025 of the Minister of Finance)</field>
        <field name="title">INCOME STATEMENT</field>
    </record>

    <record id="b02_01" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">10</field>
        <field name="code">01</field>
        <field name="name">1. Revenue from sales of goods and services</field>
        <field name="formula">CT(511) - CT(5117)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_02" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">20</field>
        <field name="code">02</field>
        <field name="name">2. Revenue deductions</field>
        <field name="formula">DT(511) - DT(5117) + BAL(521)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_10" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">30</field>
        <field name="code">10</field>
        <field name="name">3. Net revenue from sales of goods and services</field>
        <field name="formula">[01] - [02]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_11" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">40</field>
        <field name="code">11</field>
        <field name="name">4. Cost of goods sold</field>
        <field name="formula">BAL(632) - BAL(6327)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_20" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">50</field>
        <field name="code">20</field>
        <field name="name">5. Gross profit from sales of goods and services</field>
        <field name="formula">[10] - [11]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_21" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">60</field>
        <field name="code">21</field>
        <field name="name">6. Gain or loss on sale and disposal of investment property</field>
        <field name="formula">NBAL(5117) - BAL(6327)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_22" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">70</field>
        <field name="code">22</field>
        <field name="name">7. Financial income</field>
        <field name="formula">NBAL(515)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_23" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">80</field>
        <field name="code">23</field>
        <field name="name">8. Financial expenses</field>
        <field name="formula">BAL(635)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_24" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">90</field>
        <field name="code">24</field>
        <field name="name">- Of which: borrowing costs</field>
        <field name="formula">BAL(6351)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_25" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">100</field>
        <field name="code">25</field>
        <field name="name">9. Selling expenses</field>
        <field name="formula">BAL(641)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_26" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">110</field>
        <field name="code">26</field>
        <field name="name">10. General and administrative expenses</field>
        <field name="formula">BAL(642)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_30" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">120</field>
        <field name="code">30</field>
        <field name="name">11. Operating profit</field>
        <field name="formula">[20] + [21] + [22] - [23] - [25] - [26]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_31" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">130</field>
        <field name="code">31</field>
        <field name="name">12. Other income</field>
        <field name="formula">NBAL(711)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_32" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">140</field>
        <field name="code">32</field>
        <field name="name">13. Other expenses</field>
        <field name="formula">BAL(811)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_40" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">150</field>
        <field name="code">40</field>
        <field name="name">14. Other profit</field>
        <field name="formula">[31] - [32]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_50" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">160</field>
        <field name="code">50</field>
        <field name="name">15. Accounting profit before tax</field>
        <field name="formula">[30] + [40]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_51" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">170</field>
        <field name="code">51</field>
        <field name="name">16. Current corporate income tax expense</field>
        <field name="formula">BAL(8211)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_52" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">180</field>
        <field name="code">52</field>
        <field name="name">17. Deferred corporate income tax expense</field>
        <field name="formula">BAL(8212)</field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>

    <record id="b02_60" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">190</field>
        <field name="code">60</field>
        <field name="name">18. Profit after corporate income tax</field>
        <field name="formula">[50] - [51] - [52]</field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_70" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">200</field>
        <field name="code">70</field>
        <field name="name">19. Basic earnings per share (*)</field>
        <field name="formula"></field>
        <field name="level">1</field>
        <field name="bold" eval="True"/>
    </record>

    <record id="b02_71" model="vn.report.line">
        <field name="report_id" ref="report_b02"/>
        <field name="sequence">210</field>
        <field name="code">71</field>
        <field name="name">20. Diluted earnings per share (*)</field>
        <field name="formula"></field>
        <field name="level">2</field>
        <field name="bold" eval="False"/>
    </record>
</odoo>
