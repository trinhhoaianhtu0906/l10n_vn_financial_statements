#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>BAL(...)</code>: debit minus credit balance. <code>NBAL(...)</code>: credit minus debit balance."
msgstr "<code>BAL(...)</code>: số dư Nợ - Có. <code>NBAL(...)</code>: số dư Có - Nợ."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid ""
"<code>CASH(...)</code>, <code>CASHC(...)</code>, <code>CASHD(...)</code>: net cash flow / receipts / payments against the accounts (B03).\n"
"                                    <code>CASH_REST_IN()</code>, <code>CASH_REST_OUT()</code>: cash flows not used by any other line."
msgstr ""
"<code>CASH(...)</code>, <code>CASHC(...)</code>, <code>CASHD(...)</code>: dòng tiền thuần / thu / chi đối ứng với tài khoản (B03).\n"
"                                    <code>CASH_REST_IN()</code>, <code>CASH_REST_OUT()</code>: dòng tiền chưa thuộc chỉ tiêu nào khác."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>DR(...)</code> / <code>CR(...)</code>: sum of the debit / credit balances of each account."
msgstr "<code>DR(...)</code> / <code>CR(...)</code>: tổng dư Nợ / dư Có của từng tài khoản."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>DT(...)</code> / <code>CT(...)</code>: debit / credit movements of the period, closing entries (account 911) excluded."
msgstr "<code>DT(...)</code> / <code>CT(...)</code>: phát sinh Nợ / Có trong kỳ, không tính bút toán kết chuyển 911."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>OPEN(...)</code>, <code>CLOSE(...)</code>, <code>CHG(...)</code>: opening balance, closing balance, change (B03)."
msgstr "<code>OPEN(...)</code>, <code>CLOSE(...)</code>, <code>CHG(...)</code>: số dư đầu kỳ, cuối kỳ, chênh lệch (B03)."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>PDR(...)</code> / <code>PCR(...)</code>: sum of the debit / credit balances per partner (customer, vendor)."
msgstr "<code>PDR(...)</code> / <code>PCR(...)</code>: tổng dư Nợ / dư Có chi tiết theo từng đối tượng (khách hàng, nhà cung cấp)."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>PL_CUR()</code> / <code>PL_PRIOR()</code>: unclosed profit or loss of the current year / prior years (B01)."
msgstr "<code>PL_CUR()</code> / <code>PL_PRIOR()</code>: lãi lỗ chưa kết chuyển của năm nay / các năm trước (B01)."

#. module: l10n_vn_financial_statements
#: model_terms:ir.ui.view,arch_db:l10n_vn_financial_statements.vn_report_view_form
msgid "<code>[110]</code>: value of line 110 of the same report. You can use + - * / and brackets."
