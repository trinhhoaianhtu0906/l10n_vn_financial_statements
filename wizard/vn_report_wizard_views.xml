<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vn_report_wizard_view_form" model="ir.ui.view">
        <field name="name">vn.report.wizard.form</field>
        <field name="model">vn.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="options">
                    <group name="scope">
                        <field name="report_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        <field name="include_branches" groups="base.group_multi_company"/>
                    </group>
                    <group name="period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                        <field name="hide_zero"/>
                    </group>
                    <group name="comparison">
                        <field name="comparison"/>
                        <field name="comparison_count" invisible="comparison == 'none'"/>
                        <field name="show_variance" invisible="comparison == 'none'"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not warning_text">
                    <field name="warning_text" nolabel="1"/>
                </div>
                <field name="computed" invisible="1"/>
                <field name="line_ids" invisible="not computed" nolabel="1">
                    <list create="0" delete="0" decoration-bf="bold">
                        <field name="bold" column_invisible="1"/>
                        <field name="blank" column_invisible="1"/>
                        <field name="name"/>
                        <field name="display_code" string="Code"/>
                        <field name="note_ref" optional="hide"/>
                        <field name="value" string="This Period" invisible="blank"/>
                        <field name="value_cmp" string="Comparison" invisible="blank"/>
                        <field name="formula" optional="hide"/>
                        <button name="action_open_journal_items" type="object" icon="fa-search" title="Journal Items" invisible="blank"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Print PDF" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" type="object" string="Export to Excel" icon="fa-file-excel-o"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vn_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Financial Statement</field>
        <field name="res_model">vn.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
