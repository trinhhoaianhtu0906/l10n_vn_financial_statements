<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vn_report_view_list" model="ir.ui.view">
        <field name="name">vn.report.list</field>
        <field name="model">vn.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="consolidated"/>
                <button name="action_open_wizard" type="object" string="Open Report" icon="fa-play"/>
            </list>
        </field>
    </record>

    <record id="vn_report_view_form" model="ir.ui.view">
        <field name="name">vn.report.form</field>
        <field name="model">vn.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_wizard" type="object" string="Open Report" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="consolidated"/>
                        </group>
                        <group>
                            <field name="form_code"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                        </group>
                    </group>
                    <group>
                        <field name="form_note"/>
                        <field name="check_expression"/>
                        <field name="check_message"/>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="note_ref"/>
                                    <field name="formula"/>
                                    <field name="level" optional="hide"/>
                                    <field name="bold" optional="hide"/>
                                    <field name="hide_if_zero" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Formula Syntax" name="help">
                            <p>Arguments are account code prefixes: <code>131</code> matches 1311 and 1312.</p>
                            <ul>
                                <li><code>BAL(...)</code>: debit minus credit balance. <code>NBAL(...)</code>: credit minus debit balance.</li>
                                <li><code>DR(...)</code> / <code>CR(...)</code>: sum of the debit / credit balances of each account.</li>
                                <li><code>PDR(...)</code> / <code>PCR(...)</code>: sum of the debit / credit balances per partner (customer, vendor).</li>
                                <li><code>DT(...)</code> / <code>CT(...)</code>: debit / credit movements of the period, closing entries (account 911) excluded.</li>
                                <li><code>PL_CUR()</code> / <code>PL_PRIOR()</code>: unclosed profit or loss of the current year / prior years (B01).</li>
                                <li><code>OPEN(...)</code>, <code>CLOSE(...)</code>, <code>CHG(...)</code>: opening balance, closing balance, change (B03).</li>
                                <li><code>CASH(...)</code>, <code>CASHC(...)</code>, <code>CASHD(...)</code>: net cash flow / receipts / payments against the accounts (B03).
                                    <code>CASH_REST_IN()</code>, <code>CASH_REST_OUT()</code>: cash flows not used by any other line.</li>
                                <li><code>[110]</code>: value of line 110 of the same report. You can use + - * / and brackets.</li>
                            </ul>
                            <p>To customise a report, duplicate it (Action → Duplicate): upgrading the module overwrites the original reports.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vn_dynamic_report" model="ir.actions.client">
        <field name="name">Financial Statements (Circular 99)</field>
        <field name="tag">l10n_vn_financial_statements.dynamic_report</field>
    </record>

    <record id="vn_report_action" model="ir.actions.act_window">
        <field name="name">Report Templates</field>
        <field name="res_model">vn.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
